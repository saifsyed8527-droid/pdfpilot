# Browser-visible identifiers only. Restrict provider keys to approved origins/APIs.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_DRIVE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_PICKER_API_KEY=
NEXT_PUBLIC_GOOGLE_DRIVE_APP_ID=
NEXT_PUBLIC_DROPBOX_APP_KEY=
# Optional public Sentry DSN. Empty keeps error monitoring disabled.
NEXT_PUBLIC_SENTRY_DSN=
# Server-only: required for production URL-import rate limits. Never use a
# NEXT_PUBLIC prefix for either server key. Preview/local can omit both.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy fallback only when SUPABASE_SECRET_KEY is unavailable:
SUPABASE_SERVICE_ROLE_KEY=
