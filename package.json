{
  "name": "pdfpilot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "check:secrets": "node scripts/check-secret-boundaries.cjs",
    "check:public-env": "node scripts/check-secret-boundaries.cjs --env-only",
    "predev": "node scripts/prepare-pdf-image-assets.cjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "generate:assets": "node scripts/generate-assets.js",
    "pseo": "node scripts/pseo.cjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.cjs tests/*.test.mjs",
    "test:pseo": "node --test tests/pseo-engine.test.cjs",
    "prebuild": "npm run check:seo && node scripts/prepare-pdf-image-assets.cjs && npm run pseo -- validate-runtime",
    "check:seo": "node --test tests/technical-seo.test.cjs tests/international-resources.test.cjs tests/locale-ui.test.cjs tests/language-preview.test.cjs tests/international-release.test.cjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^4.1.3",
    "@next/third-parties": "^16.2.10",
    "@pdf-lib/standard-fonts": "1.0.0",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-progress": "^1.1.2",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-slot": "^1.1.2",
    "@sentry/nextjs": "11.19.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "diff": "9.0.0",
    "docx": "^9.7.1",
    "docx-preview": "0.4.1",
    "echarts": "6.1.0",
    "exifr": "7.1.3",
    "fflate": "0.8.3",
    "fontkit": "^2.0.4",
    "heic-to": "1.5.2",
    "html2canvas": "^1.4.1",
    "js-yaml": "4.3.2",
    "lucide-react": "^0.475.0",
    "mammoth": "^1.12.0",
    "marked": "18.0.6",
    "next": "15.5.29",
    "next-themes": "^0.4.6",
    "node-sql-parser": "5.4.0",
    "officeparser": "7.2.3",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "6.2.108",
    "pptxgenjs": "^4.0.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-dropzone": "^14.3.8",
    "react-hook-form": "^7.54.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.0.2",
    "tailwindcss-animate": "^1.0.7",
    "tesseract.js": "^7.0.0",
    "turndown": "7.2.4",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "xlsx-populate": "1.21.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/fontkit": "^2.0.9",
    "@types/js-yaml": "4.0.9",
    "@types/node": "^20",
    "@types/react": "19",
    "@types/react-dom": "19",
    "@types/turndown": "5.0.6",
    "eslint": "^9",
    "eslint-config-next": "15.5.29",
    "postcss": "8.5.34",
    "sharp": "0.35.5",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  },
  "overrides": {
    "pdfjs-dist": "$pdfjs-dist",
    "postcss": "$postcss",
    "source-map-js": "1.2.4",
    "image-size": "2.2.0",
    "brace-expansion@^1.1.7": "1.1.22"
  }
}
